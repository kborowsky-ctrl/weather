<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WeatherWizard.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">
    <Grid Padding="16" Background="{ThemeResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton
                Click="OnBack"
                Icon="Back"
                Label="Back" />
        </CommandBar>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppBodyTextBrush}"
                Text="Appearance" />
            <ToggleSwitch
                x:Name="DarkModeSwitch"
                Header="Dark mode (black background, light text)"
                OffContent="Light"
                OnContent="Dark"
                Toggled="OnDarkModeToggled" />
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource AppMutedTextBrush}"
                Text="Light mode uses a white background with dark text. Dark mode uses a black background with light text."
                TextWrapping="WrapWholeWords" />

            <TextBlock
                Margin="0,12,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppBodyTextBrush}"
                Text="Window" />
            <ComboBox
                x:Name="WindowPlacementBox"
                Header="Position when the app starts"
                SelectionChanged="OnWindowPlacementChanged">
                <ComboBoxItem Tag="RememberLast" Content="Remember last position and size" />
                <ComboBoxItem Tag="Center" Content="Center on screen" />
                <ComboBoxItem Tag="TopLeft" Content="Top left of work area" />
                <ComboBoxItem Tag="TopRight" Content="Top right of work area" />
                <ComboBoxItem Tag="BottomLeft" Content="Bottom left of work area" />
                <ComboBoxItem Tag="BottomRight" Content="Bottom right of work area" />
                <ComboBoxItem Tag="Left" Content="Left side (vertically centered)" />
                <ComboBoxItem Tag="Right" Content="Right side (vertically centered)" />
            </ComboBox>
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource AppMutedTextBrush}"
                Text="“Remember last” saves the window spot when you close the app; width and height are always saved for the next launch. Other options only set the corner or center using that size."
                TextWrapping="WrapWholeWords" />

            <Border
                Margin="0,8,0,0"
                Padding="0,12,0,0"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppBodyTextBrush}"
                        Text="Locations" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource AppMutedTextBrush}"
                        Text="Locations are saved automatically when you add, remove, or reorder. Use Remove to delete a saved location."
                        TextWrapping="WrapWholeWords" />
                    <NumberBox
                        x:Name="RefreshMinutesBox"
                        Header="Refresh interval (minutes)"
                        Minimum="5"
                        Maximum="120"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnRefreshMinutesChanged" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBox x:Name="CityBox" Header="City" PlaceholderText="e.g. Austin" />
                <TextBox x:Name="StateBox" Header="State / region (optional)" PlaceholderText="e.g. TX" />
                <TextBox x:Name="ZipBox" Header="ZIP (optional)" PlaceholderText="e.g. 78701" />
                <Button Click="OnSearchLocations" Content="Search &amp; add" />
            </StackPanel>

            <ListView
                x:Name="LocationsList"
                Grid.Row="1"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedLocation" xmlns:models="using:WeatherWizard.Models">
                        <Grid Padding="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AppBodyTextBrush}"
                                Text="{x:Bind TabLabel}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Click="OnMoveUp"
                                Content="Up" />
                            <Button
                                Grid.Column="2"
                                Click="OnMoveDown"
                                Content="Down" />
                            <Button
                                Grid.Column="3"
                                Click="OnRemove"
                                Content="Remove" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock
            Grid.Row="3"
            x:Name="StatusText"
            Foreground="{ThemeResource AppMutedTextBrush}"
            TextWrapping="WrapWholeWords" />
    </Grid>
</Page>
