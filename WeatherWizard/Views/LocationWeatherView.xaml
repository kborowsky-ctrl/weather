<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="WeatherWizard.Views.LocationWeatherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="420"
    VerticalAlignment="Top"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">
    <ScrollViewer
        Padding="0,0,0,0"
        VerticalAlignment="Top"
        VerticalContentAlignment="Top"
        Background="Transparent"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="10,4,10,0"
            Spacing="6"
            VerticalAlignment="Top">
            <Border
                Padding="8"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppBodyTextBrush}"
                        Text="Current conditions" />

                    <Grid ColumnSpacing="6" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="34"
                            Text="{Binding CurrentConditions.ConditionEmoji}" />

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row1Left}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row1Right}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row2Left}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row2Right}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row3Left}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row3Right}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row4Left}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row4Right}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row5SunLine}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="8"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            MaxLines="2"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding AlertSummary}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                        <HyperlinkButton
                            x:Name="AlertDetailsLink"
                            Grid.Column="1"
                            Padding="4,0"
                            VerticalAlignment="Center"
                            Content="Details"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Visibility="Collapsed" />
                    </Grid>

                    <InfoBar
                        x:Name="ErrorInfo"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error" />
                </StackPanel>
            </Border>

            <Border
                Padding="8"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppBodyTextBrush}"
                        Text="Forecast" />

                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="56" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="34" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Period" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Wx" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Weather" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="H/L" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="%" />

                        <ItemsControl
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            ItemsSource="{Binding ForecastDays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="0,2,0,2"
                                        ColumnSpacing="4"
                                        BorderBrush="{ThemeResource AppSectionBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="56" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" MinWidth="34" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="0">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppBodyTextBrush}"
                                                Text="{Binding PeriodTitle}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding DateSubtitle}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="22"
                                            Text="{Binding ConditionEmoji}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="11"
                                            Foreground="{ThemeResource AppBodyTextBrush}"
                                            MaxLines="2"
                                            Text="{Binding ConditionsDisplay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWholeWords"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="3"
                                            FontSize="11"
                                            Foreground="{ThemeResource AppBodyTextBrush}"
                                            Text="{Binding HiLoDisplay}"
                                            TextWrapping="NoWrap"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="4"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource AppBodyTextBrush}"
                                            Text="{Binding PrecipPercentDisplay}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="8,8,8,0"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppBodyTextBrush}"
                        Text="NWS radar" />

                    <Border
                        x:Name="RadarImageHost"
                        MinHeight="130"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource AppPageBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SizeChanged="RadarImageHost_SizeChanged">
                        <Grid>
                            <Image
                                x:Name="MapRasterImage"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Stretch="UniformToFill"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="RadarPlaceholder"
                                Margin="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Text="Radar is available for U.S. locations after the site id loads from weather.gov."
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Visibility="Visible" />
                        </Grid>
                    </Border>

                    <StackPanel
                        Padding="0,2,0,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="{Binding LastUpdatedText}" />
                        <HyperlinkButton
                            MinHeight="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="RefreshLink_Click"
                            Content="Refresh"
                            FontSize="10"
                            Foreground="{ThemeResource AppBodyTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
