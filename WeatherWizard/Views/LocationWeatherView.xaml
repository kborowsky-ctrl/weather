<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="WeatherWizard.Views.LocationWeatherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WeatherWizard.Views"
    d:DesignHeight="800"
    d:DesignWidth="420"
    VerticalAlignment="Top"
    Background="{ThemeResource AppPageBackgroundBrush}"
    mc:Ignorable="d">
    <ScrollViewer
        Padding="0,0,0,0"
        VerticalAlignment="Top"
        VerticalContentAlignment="Top"
        Background="Transparent"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="WeatherContentStack"
            Padding="10,4,10,4"
            Spacing="6"
            SizeChanged="WeatherContentStack_SizeChanged"
            VerticalAlignment="Top">
            <Border
                Padding="8"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppBodyTextBrush}"
                        Text="Current conditions" />

                    <Grid ColumnSpacing="6" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <views:ConditionWeatherIcon
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            IconSize="34"
                            IsNighttime="{Binding CurrentConditions.IsNighttime}"
                            PhaseTime="{Binding CurrentConditions.ObservationTime}"
                            WeatherCode="{Binding CurrentConditions.WeatherCode}" />

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row1Left}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row1Right}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row2Left}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row2Right}"
                            TextWrapping="WrapWholeWords" />

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <TextBlock
                                x:Name="PressureArrowBlock"
                                FontSize="11"
                                Foreground="{ThemeResource AppBodyTextBrush}"
                                Text="{Binding CurrentConditions.PressureArrow}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource AppBodyTextBrush}"
                                Text="{Binding CurrentConditions.Row3Left}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row3Right}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row4Left}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row4Right}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row5Left}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding CurrentConditions.Row5Right}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="8"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            FontSize="11"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="{Binding AlertSummary}"
                            TextWrapping="WrapWholeWords" />
                        <HyperlinkButton
                            x:Name="AlertDetailsLink"
                            Grid.Column="1"
                            Padding="4,0"
                            VerticalAlignment="Center"
                            Content="Details"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Visibility="Collapsed" />
                    </Grid>

                    <InfoBar
                        x:Name="ErrorInfo"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error" />
                </StackPanel>
            </Border>

            <Border
                Padding="8"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppBodyTextBrush}"
                        Text="Forecast" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Period" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Wx" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Weather" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="H/L" />
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="%" />
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ForecastDays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="0,2,0,2"
                                        ColumnSpacing="4"
                                        BorderBrush="{ThemeResource AppSectionBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="0">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppBodyTextBrush}"
                                                Text="{Binding PeriodTitle}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="{ThemeResource AppMutedTextBrush}"
                                                Text="{Binding DateSubtitle}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                        <views:ConditionWeatherIcon
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IconSize="22"
                                            IsNighttime="{Binding IsNightPeriod}"
                                            PhaseTime="{Binding MoonPhaseAt}"
                                            WeatherCode="{Binding WeatherCode}" />

                                        <views:AdaptiveForecastConditionsTextBlock
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            FullText="{Binding ConditionsDisplay}"
                                            WeatherCode="{Binding WeatherCode}"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="3"
                                            FontSize="11"
                                            Foreground="{ThemeResource AppBodyTextBrush}"
                                            Text="{Binding HiLoDisplay}"
                                            TextWrapping="NoWrap"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="4"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource AppBodyTextBrush}"
                                            Text="{Binding PrecipPercentDisplay}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="8,8,8,8"
                BorderBrush="{ThemeResource AppSectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppBodyTextBrush}"
                            Text="NWS radar" />
                        <TextBlock
                            x:Name="RadarViewHint"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="Regional view" />
                    </Grid>

                    <Border
                        x:Name="RadarImageHost"
                        MinHeight="130"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource AppPageBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SizeChanged="RadarImageHost_SizeChanged">
                        <Grid>
                            <Image
                                x:Name="MapRasterImage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="UniformToFill"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="RadarPlaceholder"
                                Margin="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Text="Radar is available for U.S. locations after the site id loads, or add custom image URLs per location in Settings."
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Visibility="Visible" />
                        </Grid>
                    </Border>

                    <Grid Padding="0,2,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource AppMutedTextBrush}"
                                Text="{Binding LastUpdatedText}" />
                            <HyperlinkButton
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="RefreshLink_Click"
                                Content="Refresh"
                                FontSize="10"
                                Foreground="{ThemeResource AppBodyTextBrush}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource AppMutedTextBrush}"
                            Text="{x:Bind VersionDisplay, Mode=OneTime}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
